<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Jellyfin.Plugin.JellyfinDownloader</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.JellyfinDownloader</RootNamespace>
    <Version>1.0.0.8</Version>
    <AssemblyVersion>1.0.0.8</AssemblyVersion>
    <FileVersion>1.0.0.8</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;NU1603</NoWarn>
    <!-- 编译产物里不残留构建机的绝对路径（DLL 的 CodeView 段会记录 PDB 路径） -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src/jellyfin-plugin-downloader</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- /script 由下面 5 个分片按声明顺序拼接而成（分片本身不是完整脚本：第一片开 IIFE，
         最后一片收尾）。顺序必须与 JellyfinDownloaderController.ScriptSegments 一致，
         改完必须 ./build.sh 才生效。 -->
    <EmbeddedResource Include="Web/inject_01_core.js" />
    <EmbeddedResource Include="Web/inject_02_entry.js" />
    <EmbeddedResource Include="Web/inject_03_panel.js" />
    <EmbeddedResource Include="Web/inject_04_search.js" />
    <EmbeddedResource Include="Web/inject_05_render.js" />
    <EmbeddedResource Include="Web/style.css" />
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

</Project>
