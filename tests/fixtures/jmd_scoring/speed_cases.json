{
  "note": "速度子分级 golden：与 backend/candidate_score.py 的 _speed_score 契约同步；由 tests/test_backend_scoring.py 逐条断言（speed 为 0-100 的子分）。速度分只剩「多少人正在做种」：aria2c 短窗测速已删除，所以这里不再有 measured 分支——测量字段出现与否必须给出逐位相同的分数（由测试统一加一遍来证明）。",
  "policy": {
    "kind": "movie",
    "duration_seconds": 7200
  },
  "cases": [
    {
      "id": "seeds-strong",
      "why": "强 swarm：种子先验封顶 1.0",
      "candidate": {
        "seeds": 141,
        "peers": 200
      },
      "expect": {
        "speed": 100.0,
        "mode": "seeds",
        "score_source": "seeds-prior"
      }
    },
    {
      "id": "seeds-weak",
      "why": "1 个种子：先验只有 0.1156，不打中性下限（有信号就信信号）",
      "candidate": {
        "seeds": 1,
        "peers": 0
      },
      "expect": {
        "speed": 11.56,
        "mode": "seeds",
        "score_source": "seeds-prior"
      }
    },
    {
      "id": "no-signal",
      "why": "完全没有 swarm 数据：中性 0.40",
      "candidate": {
        "seeds": 0,
        "peers": 0
      },
      "expect": {
        "speed": 40.0,
        "mode": "unknown",
        "score_source": "neutral"
      }
    },
    {
      "id": "external-fresh",
      "why": "announce 沉默、外部快照新鲜（≤7 天）：不打折，先验封顶",
      "candidate": {
        "seeds": 0,
        "peers": 0,
        "external_seeders": 5000,
        "external_seeders_age_days": 3.0
      },
      "expect": {
        "speed": 100.0,
        "mode": "seeds-external",
        "score_source": "seeds-prior"
      }
    },
    {
      "id": "external-stale",
      "why": "22.7 天的旧快照：折扣到 0.686，比新鲜低、仍高于中性 0.40",
      "candidate": {
        "seeds": 0,
        "peers": 0,
        "external_seeders": 5000,
        "external_seeders_age_days": 22.7
      },
      "expect": {
        "speed": 68.6,
        "mode": "seeds-external",
        "score_source": "seeds-prior"
      }
    },
    {
      "id": "announce-beats-external",
      "why": "announce 有读数时不再看外部快照（两条路给出同一个分数）",
      "candidate": {
        "seeds": 20,
        "peers": 30,
        "external_seeders": 5000,
        "external_seeders_age_days": 3.0
      },
      "expect": {
        "speed": 63.74,
        "mode": "seeds",
        "score_source": "seeds-prior"
      }
    },
    {
      "id": "dead-swarm",
      "why": "announce 判定不可达：0.05，先验被忽略",
      "candidate": {
        "seeds": 141,
        "peers": 200,
        "dead_swarm": true
      },
      "expect": {
        "speed": 5.0,
        "mode": "dead-swarm",
        "score_source": "dead-swarm"
      }
    },
    {
      "id": "dead-swarm-beats-external",
      "why": "可达性判决压过外部快照：外部 5000 也不能把死种抬起来",
      "candidate": {
        "seeds": 0,
        "peers": 0,
        "external_seeders": 5000,
        "external_seeders_age_days": 3.0,
        "dead_swarm": true
      },
      "expect": {
        "speed": 5.0,
        "mode": "dead-swarm",
        "score_source": "dead-swarm"
      }
    }
  ]
}
